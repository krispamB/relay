# sos-relay environment. Copy to .env and replace placeholders. Source of truth: src/config.ts.
# "Required" means the process exits at startup without it.

# --- Runtime ---
# Default: development. Set to production on Railway.
NODE_ENV=production
# Public HTTP port. Default 3000. Railway provides PORT; do not set it there.
PORT=3000
# Admin HTTP port. Default 3001. Must differ from PORT. Reach it only over Railway's private network.
ADMIN_PORT=3001
# Bind address. Default "::" (dual-stack), which Railway's private network needs. Leave unset on Railway.
# HOST=::
# Required. Postgres connection string. Railway: reference the Postgres service's DATABASE_URL.
DATABASE_URL=postgres://user:password@host:5432/dbname
# Default true. false = HTTP servers only, no background jobs.
RUN_JOBS=true
# Default info.
LOG_LEVEL=info
# Header holding the client address. Unset = socket address (use that locally).
# Railway: x-real-ip.
# CLIENT_IP_HEADER=x-real-ip
# Only if the relay is reached directly, with no proxy in front. Default false.
# ALLOW_SOCKET_IP_IN_PRODUCTION=false

# --- Resgrid Core ---
# Required. Base URL (http or https).
RESGRID_API_BASE=https://api.resgrid.example
# Required. Must start with rgk_ and be 40 to 100 characters. Set as a Railway secret variable.
RESGRID_API_KEY=rgk_replace_with_the_key_issued_by_resgrid_00000
# Required. Key expiry date, YYYY-MM-DD.
RESGRID_API_KEY_EXPIRES_ON=2030-01-01
# Required. Call type name used for SOS calls.
RESGRID_CALL_TYPE_NAME=SOS
# Required. Integer priority id for SOS calls.
RESGRID_PRIORITY_ID=1

# --- Intakes ---
# Required. Path to the intakes JSON file (see intakes.example.json). The Docker image does not
# include it: mount it, or write it at start-up from a Railway variable.
# Alternative to INTAKES_FILE: the intakes JSON itself, on one line. Use this on Railway.
# INTAKES_JSON=
INTAKES_FILE=./intakes.example.json

# --- Secrets ---
# All required, at least 32 bytes each. Generate with: openssl rand -hex 32
PHONE_HASH_SECRET=replace-with-random-value-of-at-least-32-bytes
ADMIN_TOKEN=replace-with-random-value-of-at-least-32-bytes

# --- Auth (sign-up, sign-in and sessions; see docs/auth-contract.md) ---
# Required, at least 32 bytes. Auth is always on: the SOS routes take the user's access token.
# Signs access tokens and derives refresh tokens: changing it signs every user out.
# Generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=replace-with-random-value-of-at-least-32-bytes

# --- SOS ---
# The Nature of every SOS call in Core, at most 200 characters. Default shown.
# SOS_NATURE_TEXT=SOS – caller recording to follow

# --- Alerts ---
# Optional. http(s) URL that receives alerts.
# ALERT_WEBHOOK_URL=https://hooks.example.com/replace-me

# --- Demo intake timing (seconds) ---
# Default 30, minimum 1.
DEMO_DISPATCH_AFTER_S=30
# Default 90. Must be greater than DEMO_DISPATCH_AFTER_S.
DEMO_CLOSE_AFTER_S=90

# --- Limits and thresholds (all optional, integers >= 0, defaults shown) ---
LIMIT_SOS_PER_USER_PER_24H=3
LIMIT_SOS_PER_PHONE_PER_24H=3
LIMIT_SOS_PER_IP_PER_HOUR=10
LIMIT_INTAKE_BREAKER_COUNT=30
LIMIT_INTAKE_BREAKER_WINDOW_S=600
LIMIT_STATUS_POLL_MIN_INTERVAL_S=5
LIMIT_REQUESTS_PER_IP_PER_MINUTE=120
HOAX_STRIKES_TO_BLOCK=2
STRIKE_TTL_DAYS=30
BLOCK_TTL_DAYS=30
QUEUE_DEPTH_WARN=10
OLDEST_QUEUED_WARN_S=300
